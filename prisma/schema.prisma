// Norla Designs — database schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

model SiteSetting {
  id                String  @id @default("singleton")
  announcementText  String  @default("Enjoy FREE shipping on all orders")
  announcementTextAr String?
  instagramUrl      String  @default("")
  tiktokUrl         String  @default("")
  whatsappUrl       String  @default("")
  facebookUrl       String  @default("")
  contactPhone      String  @default("")
  contactEmail      String  @default("")
  contactAddress    String  @default("")
  contactAddressAr  String?
  contactHours      String  @default("")
  contactHoursAr    String?
  returnPolicyText  String  @default("")
  careInstructionsText String @default("")
  careInstructionsTextAr String?
  shippingFee       Decimal @default(0) @db.Decimal(10, 2)
  depositPercent    Int     @default(50)
  freeShippingEnabled   Boolean @default(false)
  freeShippingThreshold Decimal @default(0) @db.Decimal(10, 2)
  checkoutPaymentNote   String  @default("")
  checkoutPaymentNoteAr String  @default("")
  whatsappMessageTemplate String @default("")
}

model HeroImage {
  id       String @id @default(cuid())
  url      String
  position Int    @default(0)
}

model GalleryImage {
  id       String @id @default(cuid())
  url      String
  position Int    @default(0)
}

model NavLink {
  id       String @id @default(cuid())
  label    String
  href     String
  position Int    @default(0)
}

model ShippingZone {
  id            String         @id @default(cuid())
  governorate   String         @unique
  governorateAr String?
  fee           Decimal        @default(0) @db.Decimal(10, 2)
  active        Boolean        @default(true)
  position      Int            @default(0)
  cities        ShippingCity[]
}

model ShippingCity {
  id     String       @id @default(cuid())
  zoneId String
  zone   ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name   String
  nameAr String?
}

model Testimonial {
  id           String   @id @default(cuid())
  customerName String
  quote        String
  quoteAr      String?
  rating       Int      @default(5)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  passwordHash      String
  name              String
  role              Role                @default(ADMIN)
  createdAt         DateTime            @default(now())
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  nameAr   String?
  slug     String    @unique
  imageUrl String?
  position Int       @default(0)
  products Product[]
}

model HomeSection {
  id        String              @id @default(cuid())
  title     String
  titleAr   String?
  slug      String              @unique
  position  Int                 @default(0)
  products  HomeSectionProduct[]
  createdAt DateTime            @default(now())
}

model HomeSectionProduct {
  id        String      @id @default(cuid())
  sectionId String
  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int         @default(0)

  @@unique([sectionId, productId])
}

model Product {
  id              String           @id @default(cuid())
  title           String
  titleAr         String?
  slug            String           @unique
  description     String           @default("")
  descriptionAr   String?
  shortDescription String          @default("")
  shortDescriptionAr String?
  careInstructions String          @default("")
  rating          Float            @default(5)
  reviewCount     Int              @default(0)
  price           Decimal          @db.Decimal(10, 2)
  regularPrice    Decimal?         @db.Decimal(10, 2)
  sku             String?
  stockStatus     String           @default("instock")
  stockQty        Int?
  status          String           @default("publish")
  visible         Boolean          @default(true)
  categoryId      String?
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images          ProductImage[]
  variants        ProductVariant[]
  orderItems      OrderItem[]
  homeSections    HomeSectionProduct[]
  reviews         Review[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int
  comment    String
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
}

model ProductVariant {
  id           String      @id @default(cuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label        String
  color        String?
  colorHex     String?
  size         String?
  imageUrl     String?
  price        Decimal?    @db.Decimal(10, 2)
  regularPrice Decimal?    @db.Decimal(10, 2)
  stockStatus  String      @default("instock")
  stockQty     Int?
  orderItems   OrderItem[]
}

model Customer {
  id              String   @id @default(cuid())
  name            String
  email           String?
  phone           String?
  whatsappNumber  String?
  address         String?
  governorate     String?
  city            String?
  orders          Order[]
  createdAt       DateTime @default(now())
}

model Order {
  id         String      @id @default(cuid())
  orderNo    Int         @default(autoincrement())
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id])
  status     OrderStatus @default(PENDING)
  subtotal   Decimal     @default(0) @db.Decimal(10, 2)
  shippingFee Decimal    @default(0) @db.Decimal(10, 2)
  total      Decimal     @db.Decimal(10, 2)
  depositAmount Decimal  @default(0) @db.Decimal(10, 2)
  paymentMethod String?
  items      OrderItem[]
  notes      String?
  turboOrderId String?
  turboStatus  String?
  turboRaw     String?
  turboAmountToCollect Decimal? @db.Decimal(10, 2)
  turboReturnAmount    Decimal? @db.Decimal(10, 2)
  turboReturnSummary   String?
  serviceFee Decimal     @default(0) @db.Decimal(10, 2)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  title     String
  price     Decimal         @db.Decimal(10, 2)
  quantity  Int             @default(1)
}
